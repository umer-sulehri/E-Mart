# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (card payments) ──────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── JazzCash (Pakistan mobile wallet) ───────────────────────────────────────
# Credentials from https://sandbox.jazzcash.com.pk/
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# ── EasyPaisa (Pakistan mobile wallet) ──────────────────────────────────────
# Credentials from Telenor Microfinance merchant onboarding
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# API key from https://resend.com — verified sender, e.g. "E-Mart <noreply@e-mart.app>"
RESEND_API_KEY=
EMAIL_FROM=

# ── SMS (Twilio) ────────────────────────────────────────────────────────────
# Credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
