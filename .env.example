# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=E-Mart

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Easypaisa (optional)
EASYPAISA_MERCHANT_ID=xxx
EASYPAISA_API_KEY=xxx
EASYPAISA_RETURN_URLS=https://api.emart.pk/api/v1/payments/easypaisa/callback

# JazzCash (optional)
JAZZCASH_MERCHANT_ID=xxx
JAZZCASH_PASSWORD=xxx
JAZZCASH_RETURN_URLS=https://api.emart.pk/api/v1/payments/jazzcash/callback

# Auth / secondary Supabase key (optional; falls back to anon key)
SUPABASE_SECRET_KEY=your_service_or_anon_key

# Comma-separated emails auto-promoted to admin on first Google sign-in
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# Base URL used for absolute links + API calls in sitemap/emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Set to "true" to enable the demo buyer login button
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
